# Generate with: bin/rails secret
SECRET_KEY_BASE=change-me
# Public hostname, used in password-reset email links
APP_HOST=localhost:3000
# "true" when behind HTTPS (reverse proxy / Kamal). "false" for plain HTTP on a LAN.
FORCE_SSL=false
# Optional: enable password-reset emails
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# MAIL_FROM=aircraft@example.com
