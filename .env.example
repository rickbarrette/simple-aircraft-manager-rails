# Simple Aircraft Manager settings. Copy to .env and edit; only the first
# block is required. Every setting is explained in the README.

# --- Required ----------------------------------------------------------
# Generate with: bin/rails secret  (or: openssl rand -hex 64)
# Keep a copy somewhere safe off the server: signatures and stored secrets
# depend on it, and a restore needs the same one.
SECRET_KEY_BASE=change-me
# The host name people use to reach the app (used in email links).
APP_HOST=aircraft.example.com

# The installation's time zone (scheduled jobs run on its clock; people see
# their own zone, from Profile or their device). Default UTC.
# TZ=America/New_York
# true: the app redirects to HTTPS and sets secure cookies (use behind a TLS
# proxy such as Traefik, Caddy or Cloudflare Tunnel). false: plain HTTP on a LAN.
FORCE_SSL=true

# --- Address -----------------------------------------------------------
# Full public URL, if it isn't https://APP_HOST (used for the single sign-on
# and Google Drive redirect URIs).
# APP_URL=https://aircraft.example.com

# --- Email (password resets, sign-in links, invitations, reminders, alerts)
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=false            # true for TLS from the start (default on port 465)
# MAIL_FROM=aircraft@example.com

# --- Single sign-on (OpenID Connect, e.g. Authentik) ----------------------
# OIDC_ISSUER=https://auth.example.com/application/o/aircraft/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Authentik
# OIDC_AUTO_CREATE_USERS=false   # true: create an account at first sign-in
# OIDC_TRUST_EMAIL=false         # true: link accounts by unverified email
# OIDC_ADMIN_GROUP=              # members become admins (synced at sign-in)
# PASSWORD_LOGIN=true            # false: SSO only (invited mechanics then can't sign in)

# --- Sign-in security ----------------------------------------------------
# PWNED_PASSWORDS_CHECK=true     # false if the server has no outbound internet

# --- Logbook transcription with Claude -----------------------------------
# ANTHROPIC_API_KEY=
# LOGBOOK_AI_MODEL=claude-opus-5-5
# LOGBOOK_AI_EFFORT=high

# --- Other ---------------------------------------------------------------
# APP_REPOSITORY_URL=            # source link on Admin → About (for a fork)
# RAILS_LOG_LEVEL=info
