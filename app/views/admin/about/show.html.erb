<% content_for :title, "About" %>
<% info = @info %>

<h1 class="mb-1 text-2xl font-bold">About</h1>
<p class="mb-5 text-sm text-slate-500">Simple Aircraft Manager: what's running, and how it's set up.</p>

<section class="card card-body mb-5">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-xs uppercase tracking-wide text-slate-500">Version</p>
      <p class="font-mono text-2xl font-semibold" data-version><%= info.version %></p>
      <p class="text-sm text-slate-600" data-revision>Build
        <%= info.revision_url ? link_to(info.revision, info.revision_url, class: "link font-mono", target: "_blank", rel: "noopener", title: "This commit on GitHub") : tag.span(info.revision, class: "font-mono") %></p>
      <p class="mt-1 flex flex-wrap gap-x-3 text-sm"><%= link_to "What's new", help_page_path("changelog"), class: "link" %><% if info.repository_url %><%= link_to "Source code", info.repository_url, class: "link", target: "_blank", rel: "noopener" %><% end %></p>
    </div>
    <dl class="grid grid-cols-2 gap-x-6 gap-y-1 text-sm sm:grid-cols-3">
      <div><dt class="text-slate-500">Built</dt><dd class="font-medium"><%= info.built_at ? l(info.built_at.in_time_zone, format: :short) : "—" %></dd></div>
      <div><dt class="text-slate-500">Started</dt><dd class="font-medium"><%= l(info.booted_at.in_time_zone, format: :short) %></dd></div>
      <div><dt class="text-slate-500">Uptime</dt><dd class="font-medium"><%= distance_of_time_in_words(info.booted_at, Time.current) %></dd></div>
    </dl>
  </div>
</section>

<div class="grid gap-5 lg:grid-cols-2">
  <section class="card">
    <div class="card-header"><h2 class="card-title">Runtime</h2></div>
    <%= render "pairs", pairs: info.runtime %>
  </section>

  <section class="card">
    <div class="card-header"><h2 class="card-title">Features</h2></div>
    <%= render "pairs", pairs: info.features %>
  </section>

  <section class="card">
    <div class="card-header"><h2 class="card-title">Key components</h2></div>
    <%= render "pairs", pairs: info.key_gems %>
  </section>

  <div class="space-y-5">
    <section class="card">
      <div class="card-header"><h2 class="card-title">Storage</h2></div>
      <% s = info.storage %>
      <%= render "pairs", pairs: [
            [ "Uploaded files", "#{number_with_delimiter(s[:files])} (#{number_to_human_size(s[:bytes])})" ],
            [ "Saved by storing duplicates once", number_to_human_size(s[:shared_bytes]) ],
            [ "Free disk space", s[:free_bytes] && number_to_human_size(s[:free_bytes]) ]
          ] + info.databases.map { |label, bytes| [ "#{label} database", bytes && number_to_human_size(bytes) ] } %>
    </section>

    <section class="card">
      <div class="card-header">
        <h2 class="card-title">Email</h2>
        <%= button_to "Send test email", admin_test_email_path, class: "btn-secondary btn-sm", disabled: !MailSettings.configured?,
              data: { turbo_submits_with: "Sending…" }, title: "Sends to #{current_user.email_address}" %>
      </div>
      <%= render "pairs", pairs: MailSettings.summary.merge("Weekly reminders" => "Mondays, to owners who haven't turned them off") %>
      <div class="px-4 pb-3"><%= button_to "Send me this week's reminder", admin_test_reminder_path, class: "btn-secondary btn-sm", disabled: !MailSettings.configured? %></div>
    </section>

    <section class="card">
      <div class="card-header"><h2 class="card-title">Background jobs</h2></div>
      <% if (j = info.jobs) %>
        <%= render "pairs", pairs: [
              [ "Workers running", j[:workers].zero? ? tag.span("none", class: "badge-red") : j[:workers] ],
              [ "Waiting", j[:ready] ], [ "Scheduled", j[:scheduled] ],
              [ "Failed", j[:failed].positive? ? tag.span(j[:failed], class: "badge-orange") : 0 ]
            ] %>
      <% else %>
        <%= empty_state "Job queue not available." %>
      <% end %>
    </section>

    <section class="card">
      <div class="card-header"><h2 class="card-title">Records</h2></div>
      <%= render "pairs", pairs: info.record_counts.transform_values { number_with_delimiter(_1) } %>
    </section>
  </div>
</div>

<section class="card mt-5" id="records">
  <div class="card-header">
    <div>
      <h2 class="card-title">Records integrity</h2>
      <p class="text-xs text-slate-500">Nightly: a verified database backup, then a check of the record history chains and every electronic signature (AC 120-78B 3.2).</p>
    </div>
    <%= button_to "Back up and check now", admin_check_records_path, class: "btn-secondary btn-sm", data: { turbo_submits_with: "Checking…" } %>
  </div>
  <% check = IntegrityCheck.latest %>
  <% backup = BackupRun.latest %>
  <%= render "pairs", pairs: [
        [ "Last check", check ? "#{l(check.created_at, format: :short)} · #{check.ok ? 'no problems' : pluralize(check.problems.size, 'problem')}" : "not run yet" ],
        [ "Checked", check ? "#{number_with_delimiter(check.versions_checked)} history entries, #{number_with_delimiter(check.signatures_checked)} signatures" : nil ],
        [ "Last backup", backup ? "#{l(backup.created_at, format: :short)} · #{backup.ok ? number_to_human_size(backup.bytes) : 'FAILED'}" : "not run yet" ],
        [ "Backup check", backup&.message ],
        [ "Backups kept", "#{Setting.integer('backups_kept')} (in storage/backups)" ],
        [ "Off-site backup", OffsiteConnection.connected? ? ((o = OffsiteRun.latest_backup) ? tag.span("#{o.ok ? 'OK' : 'FAILED'} #{o.created_at.to_date}", class: (o.ok && o.recent? ? nil : "badge-orange")) + " · Google Drive (#{OffsiteConnection.current.account_email})" : "Google Drive connected, none yet") : link_to("not set up", admin_offsite_backup_path, class: "badge-orange") ],
        [ "Procedures", (r = ProceduresRevision.current) ? "Revision #{r.number}, adopted #{r.adopted_at.to_date}" : tag.span("not adopted", class: "badge-orange") ],
        [ "Last audit", AuditRun.latest ? "#{AuditRun.latest.performed_at.to_date} · #{AuditRun.latest.passed ? 'passed' : 'items not passed'}" : "none yet" ],
        [ "Next audit due", AuditRun.due_soon? ? tag.span(AuditRun.next_due.to_s, class: "badge-orange") : AuditRun.next_due.to_s ]
      ] %>
  <% if check && !check.ok %>
    <ul class="list-disc space-y-1 px-8 pb-3 text-sm text-red-700"><% check.problems.each do |p| %><li><%= p %></li><% end %></ul>
  <% end %>
</section>

<section class="card mt-5">
  <div class="card-header"><h2 class="card-title">Software versions</h2></div>
  <% revisions = AppRevision.latest_first.limit(20) %>
  <% if revisions.any? %>
    <%= render "pairs", pairs: revisions.map { |r| [ [ r.version, "build #{r.revision}" ].compact.join(" · "), "#{l(r.first_seen_at, format: :short)} – #{l(r.last_seen_at, format: :short)}" ] } %>
  <% else %>
    <%= empty_state "No versions recorded yet." %>
  <% end %>
</section>

<details class="card mt-5">
  <summary class="card-header cursor-pointer"><span class="card-title">All gems (<%= info.all_gems.size %>)</span></summary>
  <div class="grid gap-x-6 px-4 py-3 font-mono text-xs sm:grid-cols-2 lg:grid-cols-3">
    <% info.all_gems.each do |name, version| %>
      <div class="flex justify-between gap-2 py-0.5"><span class="truncate"><%= name %></span><span class="text-slate-500"><%= version %></span></div>
    <% end %>
  </div>
</details>
