<%= form_with model: [:admin, user], class: "card card-body space-y-4 max-w-md" do |f| %>
  <%= f.errors_summary %>
  <%= f.field :name %>
  <%= f.field :email_address, as: :email, label: "Email", required: true %>
  <%= f.field :password, as: :password, hint: (user.persisted? ? "Leave blank to keep current password." : "At least 8 characters."), autocomplete: "new-password" %>
  <%= f.field :password_confirmation, as: :password %>
  <%= f.field :admin, as: :checkbox, label: "Administrator", hint: "Admins can see and edit every aircraft and manage users." %>
  <div class="flex gap-2"><%= f.submit "Save" %><%= link_to "Cancel", admin_users_path, class: "btn-secondary" %></div>
<% end %>
<% if user.persisted? && user != current_user %><div class="mt-4"><%= delete_button "Delete user", admin_user_path(user) %></div><% end %>
