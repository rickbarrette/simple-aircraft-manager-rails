<% content_for :title, "Users" %>
<div class="mb-4 flex items-center justify-between"><h1 class="text-2xl font-bold">Users</h1><%= link_to "+ New User", new_admin_user_path, class: "btn-primary" %></div>
<section class="card"><table class="table">
  <thead><tr><th>Name</th><th>Email</th><th>Aircraft</th><th></th></tr></thead>
  <tbody><% @users.each do |u| %><tr>
    <td><%= u.name %> <% if u.admin? %><span class="badge-blue">Admin</span><% end %></td>
    <td><%= u.email_address %></td>
    <td class="text-xs"><%= u.aircraft_roles.map { "#{_1.aircraft.tail_number} (#{_1.role})" }.join(", ").presence || "—" %></td>
    <td class="text-right"><%= link_to "Edit", edit_admin_user_path(u), class: "btn-secondary btn-sm" %></td>
  </tr><% end %></tbody>
</table></section>
<p class="hint mt-3">After creating an account, an aircraft owner can grant access from the aircraft's “Access & Sharing” tab.</p>
