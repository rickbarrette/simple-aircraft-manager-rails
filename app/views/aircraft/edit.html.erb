<% content_for :title, "Edit #{@aircraft.tail_number}" %>
<%= render "shared/aircraft_header", aircraft: @aircraft %>
<%= render "form", aircraft: @aircraft %>
<div class="mt-6 max-w-3xl card card-body border-red-200">
  <h2 class="font-semibold text-red-700">Danger zone</h2>
  <p class="text-sm text-slate-600 mb-3">Deleting an aircraft removes all of its records, documents and history.</p>
  <%= delete_button "Delete #{@aircraft.tail_number}", aircraft_path(@aircraft),
        confirm: "Delete #{@aircraft.tail_number} and ALL its records? This cannot be undone.", class: "btn-danger" %>
</div>
