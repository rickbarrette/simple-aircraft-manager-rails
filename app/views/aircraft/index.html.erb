<% content_for :title, t(".fleet") %>
<div class="mb-5 flex items-center justify-between">
  <h1 class="text-2xl font-bold tracking-tight"><%= t(".fleet") %></h1>
  <div class="flex gap-2">
    <%= more_menu do %><%= link_to t(".import_from_a_sam_zip"), new_aircraft_import_path, class: "menu-item" %><% end %>
    <%= link_to t(".add_aircraft"), new_aircraft_path, class: "btn-primary" %>
  </div>
</div>

<% if @aircraft_list.empty? %>
  <div class="card card-body text-center">
    <p class="text-slate-600"><%= t(".no_aircraft_yet") %></p>
    <p class="mt-3"><%= link_to t(".add_your_first_aircraft"), new_aircraft_path, class: "btn-primary" %></p>
  </div>
<% else %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @aircraft_list.each do |aircraft| %>
      <% aw = aircraft.airworthiness %>
      <%= link_to aircraft_path(aircraft), class: "card block overflow-hidden transition hover:shadow-md" do %>
        <div class="flex h-36 items-center justify-center bg-slate-200">
          <% if aircraft.picture_shown? %>
            <%= image_tag aircraft.picture_for(:card), class: "h-full w-full object-cover", loading: "lazy", alt: t(".photo_of", tail_number: aircraft.tail_number) %>
          <% else %>
            <span class="text-5xl text-slate-400" aria-hidden="true">✈</span>
          <% end %>
        </div>
        <div class="card-body">
          <div class="flex items-start justify-between gap-2">
            <div>
              <div class="text-lg font-bold"><%= aircraft.tail_number %></div>
              <div class="text-sm text-slate-500"><%= [aircraft.make, aircraft.model].compact_blank.join(" ").presence || "—" %></div>
            </div>
            <%= airworthiness_badge(aw) %>
          </div>
          <div class="mt-3 flex items-center justify-between text-sm text-slate-600">
            <span><%= t(".tach_html", tach_time: (hours(aircraft.tach_time))) %></span>
            <%= aircraft_status_badge(aircraft) %>
          </div>
          <% if aw.issues.any? %>
            <ul class="mt-3 space-y-1 text-xs">
              <% aw.issues.first(3).each do |issue| %>
                <li class="<%= issue_text_class(issue) %>">• <%= issue.title %></li>
              <% end %>
              <% if aw.issues.size > 3 %><li class="text-slate-500"><%= t(".more_html", issues: (aw.issues.size - 3)) %></li><% end %>
            </ul>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
