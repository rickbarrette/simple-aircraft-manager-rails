<% content_for :title, "Fleet" %>
<div class="mb-5 flex items-center justify-between">
  <h1 class="text-2xl font-bold tracking-tight">Fleet</h1>
  <div class="flex gap-2">
    <%= link_to "Import", new_aircraft_import_path, class: "btn-secondary", title: "Import an aircraft from a .sam.zip archive" %>
    <%= link_to "+ Add Aircraft", new_aircraft_path, class: "btn-primary" %>
  </div>
</div>

<% if @aircraft_list.empty? %>
  <div class="card card-body text-center">
    <p class="text-slate-600">No aircraft yet.</p>
    <p class="mt-3"><%= link_to "Add your first aircraft", new_aircraft_path, class: "btn-primary" %></p>
  </div>
<% else %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <% @aircraft_list.each do |aircraft| %>
      <% aw = aircraft.airworthiness %>
      <%= link_to aircraft_path(aircraft), class: "card block overflow-hidden transition hover:shadow-md" do %>
        <div class="flex h-36 items-center justify-center bg-slate-200">
          <% if aircraft.picture.attached? %>
            <%= image_tag aircraft.picture, class: "h-full w-full object-cover" %>
          <% else %>
            <span class="text-5xl text-slate-400">✈</span>
          <% end %>
        </div>
        <div class="card-body">
          <div class="flex items-start justify-between gap-2">
            <div>
              <div class="text-lg font-bold"><%= aircraft.tail_number %></div>
              <div class="text-sm text-slate-500"><%= [aircraft.make, aircraft.model].compact_blank.join(" ").presence || "—" %></div>
            </div>
            <%= airworthiness_badge(aw) %>
          </div>
          <div class="mt-3 flex items-center justify-between text-sm text-slate-600">
            <span>Tach <strong><%= hours(aircraft.tach_time) %></strong></span>
            <%= aircraft_status_badge(aircraft) %>
          </div>
          <% if aw.issues.any? %>
            <ul class="mt-3 space-y-1 text-xs">
              <% aw.issues.first(3).each do |issue| %>
                <li class="<%= issue.severity == 'RED' ? 'text-red-700' : 'text-amber-700' %>">• <%= issue.title %></li>
              <% end %>
              <% if aw.issues.size > 3 %><li class="text-slate-500">+ <%= aw.issues.size - 3 %> more</li><% end %>
            </ul>
          <% end %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
