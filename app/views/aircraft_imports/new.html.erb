<% content_for :title, t(".import_aircraft") %>
<div class="mx-auto max-w-2xl space-y-5">
  <h1 class="text-2xl font-bold tracking-tight"><%= t(".import_an_aircraft") %></h1>
  <section class="card card-body space-y-4">
    <p class="text-sm text-slate-600">
      <%= t(".upload_a_sam_zip_archive_html") %>
      <%= t(".everything_in_it_is_added") %>
    </p>
    <% if @preview %>
      <div class="rounded-md bg-slate-50 px-3 py-2 text-sm ring-1 ring-slate-200">
        <%= t(".archive_html", tail_number: @preview.tail_number, make_model: ([ @preview.make, @preview.model ].compact_blank.join(" "))) %>
        <% if @preview.exported_at %><span class="text-slate-500"><%= t(".exported_html", to_date: (fmt_date(@preview.exported_at.to_date))) %></span><% end %>
      </div>
    <% end %>
    <%= form_with url: aircraft_imports_path, multipart: true, class: "space-y-4" do |f| %>
      <div>
        <%= f.label :archive, t(".archive_sam_zip"), class: "label" %>
        <%= f.file_field :archive, accept: ".zip,application/zip", required: true,
              class: "block text-sm text-slate-600 file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-1.5 file:text-sm file:font-medium hover:file:bg-slate-200" %>
        <% if @conflict %><p class="hint mt-1"><%= t(".choose_the_file_again_along") %></p><% end %>
      </div>
      <div class="max-w-xs">
        <%= f.label :tail_number, t(".tail_number"), class: "label" %>
        <%= f.text_field :tail_number, value: (params[:tail_number] unless @conflict), class: "input uppercase",
              placeholder: @preview&.tail_number || t(".from_the_archive"), required: @conflict.present? %>
        <p class="hint mt-1"><%= t(".leave_blank_to_use_the") %></p>
      </div>
      <div class="flex gap-2"><%= f.submit t(".import"), class: "btn-primary" %><%= link_to t(".cancel"), root_path, class: "btn-secondary" %></div>
    <% end %>
  </section>
</div>
