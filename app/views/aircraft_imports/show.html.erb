<% content_for :title, "Aircraft Import" %>
<% if @import.in_progress? %><% content_for :head, tag.meta("http-equiv": "refresh", content: "2") %><% end %>
<div class="mx-auto max-w-2xl space-y-5">
  <h1 class="text-2xl font-bold tracking-tight">Importing <%= @import.tail_number %></h1>
  <section class="card card-body space-y-3 text-sm" id="import-status">
    <p class="text-slate-500"><%= @import.filename %><%= " · from #{@import.source}" if @import.source.present? %></p>
    <% if @import.in_progress? %>
      <p class="flex items-center gap-2 font-medium"><span class="inline-block h-3 w-3 animate-pulse rounded-full bg-sky-500"></span>
        <%= @import.status == "queued" ? "Waiting to start…" : "Importing…" %></p>
      <% if @import.counts.any? %><p class="text-slate-600">So far: <%= @import.summary %>.</p><% end %>
      <p class="hint">This page updates by itself. Large archives with many documents can take a few minutes.</p>
    <% elsif @import.done? %>
      <p class="font-medium text-emerald-700">Imported.</p>
      <p class="text-slate-600"><%= @import.summary.presence&.upcase_first || "No records" %>.</p>
      <% if @import.aircraft %><p><%= link_to "Open #{@import.aircraft.tail_number} →", aircraft_path(@import.aircraft), class: "btn-primary" %></p><% end %>
    <% else %>
      <p class="font-medium text-red-700">The import failed. Nothing was added.</p>
      <p class="text-slate-600"><%= @import.error %></p>
      <p><%= link_to "Try another file", new_aircraft_import_path, class: "btn-secondary" %></p>
    <% end %>
    <% if @import.warnings.any? %>
      <div class="border-t border-slate-100 pt-3">
        <p class="mb-1 text-xs font-semibold text-slate-500"><%= pluralize(@import.warnings.size, "note") %></p>
        <ul class="list-disc space-y-0.5 pl-5 text-slate-600"><% @import.warnings.each do |w| %><li><%= w %></li><% end %></ul>
      </div>
    <% end %>
  </section>
</div>
