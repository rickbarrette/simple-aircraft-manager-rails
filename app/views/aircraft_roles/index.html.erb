<% content_for :title, t(".access", tail_number: @aircraft.tail_number) %>
<%= render "shared/aircraft_header", aircraft: @aircraft %>
<h2 class="mb-4 text-lg font-semibold"><%= t(".access_sharing_html") %></h2>
<div class="grid gap-5 lg:grid-cols-2">
  <section class="card">
    <div class="card-header"><h2 class="card-title"><%= t(".people") %></h2></div>
    <table class="table">
      <tbody>
        <% @roles.each do |r| %>
          <tr>
            <td><%= r.user.display_name %><div class="text-xs text-slate-500"><%= r.user.email_address %></div></td>
            <td>
              <%= form_with url: aircraft_aircraft_role_path(@aircraft, r), method: :patch do |f| %>
                <%= f.select :role, AircraftRole::ROLES.invert, { selected: r.role }, class: "input w-28", data: { submit_on_change: true } %>
              <% end %>
            </td>
            <td class="text-right"><% unless r.user == current_user %><%= delete_button t(".remove"), aircraft_aircraft_role_path(@aircraft, r), confirm: t(".remove_s_access", display_name: r.user.display_name) %><% end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= form_with url: aircraft_aircraft_roles_path(@aircraft), class: "flex flex-wrap items-end gap-2 border-t border-slate-100 p-4" do |f| %>
      <div class="flex-1"><%= f.label :email_address, t(".add_by_email"), class: "label" %><%= f.email_field :email_address, class: "input", required: true %></div>
      <%= f.select :role, AircraftRole::ROLES.invert, { selected: "pilot" }, class: "input w-28" %>
      <%= f.submit t(".add"), class: "btn-primary" %>
    <% end %>
    <p class="px-4 pb-4 hint"><%= t(".owners_can_edit_everything_pilots_html") %></p>
  </section>

  <section class="card">
    <div class="card-header"><h2 class="card-title"><%= t(".share_links") %></h2></div>
    <% if @share_tokens.any? %>
      <ul class="divide-y divide-slate-100">
        <% @share_tokens.each do |t| %>
          <li class="px-4 py-3">
            <div class="flex items-center justify-between gap-2">
              <div>
                <span class="font-medium"><%= t.label.presence || t(".untitled_link") %></span>
                <%= tag.span ShareToken::PRIVILEGES[t.privilege], class: t.maintenance? ? "badge-blue" : "badge-green" %>
                <% if t.expired? %><span class="badge-red"><%= t(".expired") %></span><% end %>
              </div>
              <%= delete_button t(".revoke"), aircraft_share_token_path(@aircraft, t), confirm: t(".revoke_this_link_anyone_using") %>
            </div>
            <input type="text" readonly value="<%= shared_url(t.token) %>" class="input mt-2 font-mono text-xs" data-select-on-click>
            <div class="mt-1 text-xs text-slate-500"><%= t(".created_html", to_date: (fmt_date(t.created_at.to_date)), created_by: (" by #{t.created_by.display_name}" if t.created_by), expires: (t.expires_at ? "expires #{l t.expires_at, format: :short}" : t(".never_expires"))) %></div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= empty_state t(".no_share_links") %>
    <% end %>
    <%= form_with model: ShareToken.new, url: aircraft_share_tokens_path(@aircraft), class: "space-y-3 border-t border-slate-100 p-4" do |f| %>
      <div class="grid gap-3 sm:grid-cols-3">
        <%= f.field :label, placeholder: t(".mechanic_buyer") %>
        <%= f.field :privilege, as: :select, label: t(".shows"), collection: ShareToken::PRIVILEGES.invert %>
        <%= f.field :expires_at, as: :datetime, label: t(".expires_optional") %>
      </div>
      <p class="hint"><%= t(".current_status_overview_airworthiness_components_html") %></p>
      <%= f.submit t(".create_share_link") %>
    <% end %>
  </section>

  <section class="card lg:col-span-2">
    <div class="card-header">
      <div>
        <h2 class="card-title"><%= t(".backup_transfer_html") %></h2>
        <p class="hint"><%= t(".everything_recorded_for_with_its_html", tail_number: @aircraft.tail_number) %></p>
      </div>
      <%= link_to t(".download_sam_zip"), aircraft_export_path(@aircraft), class: "btn-secondary", data: { turbo: false } %>
    </div>
    <div class="card-header border-t border-slate-100">
      <div>
        <h2 class="card-title"><%= t(".records_package") %></h2>
        <p class="hint"><%= t(".for_an_faa_or_ntsb") %></p>
      </div>
      <%= link_to t(".download_records_package"), aircraft_records_package_path(@aircraft), class: "btn-secondary", data: { turbo: false } %>
    </div>
  </section>
</div>
