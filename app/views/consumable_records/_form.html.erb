<%= form_with model: [aircraft, record], class: "card card-body space-y-4 max-w-2xl" do |f| %>
  <%= f.errors_summary %>
  <div class="grid gap-4 sm:grid-cols-2">
    <%= f.field :record_type, as: :select, label: t(".type"), collection: ConsumableRecord::TYPES.invert %>
    <%= f.field :date, as: :date %>
    <%= f.field :quantity_added, as: :number, step: 0.01, label: t(".quantity_added_qt_gal") %>
    <%= f.field :level_after, as: :number, step: 0.01, label: t(".level_after") %>
    <%= f.field :consumable_type, label: t(".product"), placeholder: t(".aeroshell_w100_100ll") %>
    <%= f.field :flight_hours, as: :number, step: 0.1, label: t(".tach_at_time_of_record") %>
  </div>
  <%= f.field :notes, as: :textarea, rows: 2 %>
  <%= f.field :excluded_from_averages, as: :checkbox, label: t(".exclude_from_averages"), hint: t(".use_for_oil_changes_the") %>
  <div class="flex gap-2"><%= f.submit t(".save") %><%= link_to t(".cancel"), aircraft_consumable_records_path(aircraft), class: "btn-secondary" %></div>
<% end %>
<% if record.persisted? %><div class="mt-4"><%= delete_button t(".delete_record"), aircraft_consumable_record_path(aircraft, record) %></div><% end %>
