<% content_for :title, "#{@aircraft.tail_number} Oil & Fuel" %>
<%= render "shared/aircraft_header", aircraft: @aircraft %>
<%= render "shared/oil_subnav", aircraft: @aircraft %>
<div class="grid gap-5 lg:grid-cols-2">
  <% [@oil, @fuel].each do |stats| %>
    <section class="card">
      <div class="card-header">
        <h2 class="card-title"><%= stats.oil? ? "Oil Consumption" : "Fuel Burn" %></h2>
        <%= link_to "+ Add #{stats.oil? ? 'Oil' : 'Fuel'}", new_aircraft_consumable_record_path(@aircraft, type: stats.record_type), class: "btn-secondary btn-sm" %>
      </div>
      <div class="card-body">
        <div class="mb-3 flex flex-wrap gap-x-6 gap-y-1 text-sm">
          <div><span class="text-2xl font-semibold"><%= stats.recent || "—" %></span> <span class="text-slate-500"><%= stats.metric_label %>, last ~<%= stats.recent_window_hours %> hrs</span></div>
          <div><span class="text-lg"><%= stats.lifetime || "—" %></span> <span class="text-slate-500">lifetime</span></div>
        </div>
        <% if stats.points.size >= 2 %>
          <%= line_chart stats.chart_data, xtitle: "Tach hours", ytitle: stats.metric_label, height: "220px", curve: false, points: false,
                library: { scales: { x: { type: "linear" } } }, colors: [stats.oil? ? "#b45309" : "#0369a1"] %>
          <p class="hint">Rolling <%= stats.chart_window_hours %>-hour window: total <%= stats.oil? ? "oil" : "fuel" %> added ÷ hours flown, so partial fills average out.<%= " Higher is better." if stats.oil? %></p>
        <% else %>
          <%= empty_state "Not enough history yet (need more than #{stats.chart_window_hours} tach hours of records)." %>
        <% end %>
      </div>
    </section>
  <% end %>
</div>

<section class="card mt-5">
  <div class="card-header"><h2 class="card-title">Records</h2></div>
  <% if @records.any? %>
    <%= render "consumable_records/records", records: @records, page: @page, more: @more %>
  <% else %>
    <%= empty_state "No oil or fuel records yet." %>
  <% end %>
</section>
