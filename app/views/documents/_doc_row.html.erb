<li class="flex items-center justify-between gap-3 px-4 py-2">
  <div>
    <%= link_to doc.name, aircraft_document_path(aircraft, doc), class: "link font-medium" %>
    <span class="ml-2 text-xs text-slate-500"><%= doc.type_label %> · <%= t("counts.file", count: doc.pages.size) %></span>
    <% if doc.legacy_record? %><span class="ml-1 badge-gray" title="<%= t(".scan_of_the_paper_legacy") %>"><%= t(".legacy_record") %></span><% end %>
    <% if doc.expires_on %><span class="ml-1 <%= doc.expired? ? 'badge-red' : (Date.current + doc.expiry_warning_days >= doc.expires_on ? 'badge-orange' : 'badge-gray') %>"><%= doc.expired? ? t(".expired") : t(".expires") %> <%= fmt_date(doc.expires_on) %></span><% end %>
    <% if doc.description.present? %><div class="text-xs text-slate-500"><%= doc.description.truncate(120) %></div><% end %>
  </div>
  <div class="flex items-center gap-2">
    <%= visibility_badge(doc.effective_visibility) %>
    <% if owner? %><%= link_to t(".edit"), edit_aircraft_document_path(aircraft, doc), class: "btn-secondary btn-sm" %><% end %>
  </div>
</li>
