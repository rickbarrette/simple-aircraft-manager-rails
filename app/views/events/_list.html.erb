<% if events.any? %>
  <ul class="divide-y divide-slate-100">
    <% events.each do |e| %>
      <li class="px-4 py-2 text-sm">
        <div class="flex items-center justify-between gap-2">
          <span><%= e.event_name %></span>
          <span class="badge-gray"><%= AircraftEvent::CATEGORIES[e.category] %></span>
        </div>
        <div class="text-xs text-slate-500"><%= t(".ago_html", who: (e.user&.display_name || t(".system")), created_at: (time_ago_in_words(e.created_at))) %></div>
        <% if e.notes.present? && local_assigns[:full] %><div class="mt-1 text-xs text-slate-600"><%= e.notes %></div><% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <%= empty_state t(".no_activity_yet") %>
<% end %>
