<%# One page of the activity log, in its own frame; a lazy frame after it
    loads the next page when it scrolls into view. Links open in the whole page. %>
<%= turbo_frame_tag "events-#{page}", target: "_top", class: ["block", ("border-t border-slate-100" if page > 1)] do %>
  <%= render "events/list", events: events, full: true %>
  <% if more %>
    <% next_page = aircraft_events_path(@aircraft, category: category, page: page + 1) %>
    <%= turbo_frame_tag "events-#{page + 1}", src: next_page, loading: :lazy, target: "_top", class: "block border-t border-slate-100" do %>
      <p class="px-4 py-4 text-center text-sm text-slate-500">
        <%= t(".loading_earlier_activity_html", link: (link_to t(".load_more"), next_page, class: "link", data: { turbo_frame: "events-#{page + 1}" })) %>
      </p>
    <% end %>
  <% end %>
<% end %>
