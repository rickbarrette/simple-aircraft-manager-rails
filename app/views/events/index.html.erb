<% content_for :title, t(".activity", tail_number: @aircraft.tail_number) %>
<%= render "shared/aircraft_header", aircraft: @aircraft %>
<section class="card">
  <div class="card-header">
    <h2 class="card-title"><%= t(".activity_log") %></h2>
    <div class="flex flex-wrap items-center gap-2">
    <%= link_to t(".record_history"), aircraft_record_versions_path(@aircraft), class: "btn-secondary btn-sm", title: t(".every_change_to_the_maintenance") %>
    <%= form_with url: aircraft_events_path(@aircraft), method: :get, class: "flex gap-2" do |f| %>
      <%= f.select :category, AircraftEvent::CATEGORIES.invert, { include_blank: t(".all_categories"), selected: @category }, class: "input", data: { submit_on_change: true } %>
    <% end %>
    </div>
  </div>
  <%= render "events/list", events: @events, full: true %>
</section>
