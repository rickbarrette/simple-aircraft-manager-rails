<% content_for :title, "#{@aircraft.tail_number} Flights" %>
<%= render "shared/aircraft_header", aircraft: @aircraft %>
<section class="card">
  <div class="card-header"><h2 class="card-title">Flight Log</h2><div class="flex gap-2"><% if owner? %><%= link_to "Import from spreadsheet", new_aircraft_flight_import_path(@aircraft), class: "btn-secondary" %><% end %><%= link_to "+ Log Flight", new_aircraft_flight_log_path(@aircraft), class: "btn-primary" %></div></div>
  <% if @flight_logs.any? %>
    <div class="overflow-x-auto">
      <table class="table">
        <thead><tr><th>Date</th><th>Route</th><th class="text-right">Tach</th><th class="text-right">Hobbs</th><th class="text-right">Oil</th><th class="text-right">Fuel</th><th>Pilot</th><th></th></tr></thead>
        <tbody>
          <% @flight_logs.each do |fl| %>
            <tr>
              <td class="whitespace-nowrap"><%= link_to fl.date, aircraft_flight_log_path(@aircraft, fl), class: "link" %></td>
              <td><%= fl.route_summary.presence || "—" %></td>
              <td class="text-right tabular-nums"><%= hours(fl.tach_time) %></td>
              <td class="text-right tabular-nums"><%= hours(fl.hobbs_time) %></td>
              <td class="text-right tabular-nums"><%= fl.oil_added ? "#{fl.oil_added} qt" : "" %></td>
              <td class="text-right tabular-nums"><%= fl.fuel_added ? "#{fl.fuel_added} gal" : "" %></td>
              <td class="text-xs"><%= fl.user&.display_name %></td>
              <td class="text-right"><%= "📍" if fl.track_log.attached? %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <%= empty_state "No flights logged yet." %>
  <% end %>
</section>
