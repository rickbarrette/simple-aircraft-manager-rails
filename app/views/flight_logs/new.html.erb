<% content_for :title, "Log Flight" %>
<%= render "shared/aircraft_header", aircraft: @aircraft %>
<%= form_with model: [@aircraft, @flight_log], class: "card card-body space-y-5 max-w-3xl",
      data: { controller: "offline-flight", offline_flight_tail_value: @aircraft.tail_number,
              action: "submit->offline-flight#submit turbo:submit-start->offline-flight#remember turbo:fetch-request-error->offline-flight#networkFailed" } do |f| %>
  <%= f.hidden_field :client_key, data: { offline_flight_target: "key" } %>
  <div class="hidden rounded-md bg-sky-50 px-3 py-2 text-sm text-sky-900 ring-1 ring-sky-200" data-offline-flight-target="notice" role="status"></div>
  <%= f.errors_summary %>
  <div class="grid gap-4 sm:grid-cols-3">
    <%= f.field :date, as: :date, required: true %>
    <%= render "shared/airport_field", f: f, attribute: :departure_location, label: "From", aircraft: @aircraft, placeholder: "KOQU" %>
    <%= render "shared/airport_field", f: f, attribute: :destination_location, label: "To", aircraft: @aircraft, placeholder: "Code or name" %>
  </div>
  <fieldset class="grid gap-4 sm:grid-cols-3">
    <legend class="mb-2 text-sm font-semibold">Tach (required)</legend>
    <%= f.field :tach_out, as: :number, step: 0.1, label: "Tach out" %>
    <%= f.field :tach_in, as: :number, step: 0.1, label: "Tach in" %>
    <%= f.field :tach_time, as: :number, step: 0.1, label: "…or duration", hint: "Calculated from out/in if blank." %>
  </fieldset>
  <fieldset class="grid gap-4 sm:grid-cols-3">
    <legend class="mb-2 text-sm font-semibold">Hobbs (optional)</legend>
    <%= f.field :hobbs_out, as: :number, step: 0.1, label: "Hobbs out" %>
    <%= f.field :hobbs_in, as: :number, step: 0.1, label: "Hobbs in" %>
    <%= f.field :hobbs_time, as: :number, step: 0.1, label: "…or duration" %>
  </fieldset>
  <fieldset class="grid gap-4 sm:grid-cols-3">
    <legend class="mb-2 text-sm font-semibold">Oil & fuel added</legend>
    <%= f.field :oil_added, as: :number, step: 0.25, label: "Oil added (qt)" %>
    <%= f.field :oil_level_after, as: :number, step: 0.25, label: "Oil level after (qt)" %>
    <%= f.field :oil_added_type, label: "Oil type", placeholder: "Aeroshell W100" %>
    <%= f.field :fuel_added, as: :number, step: 0.1, label: "Fuel added (gal)" %>
    <%= f.field :fuel_level_after, as: :number, step: 0.1, label: "Fuel level after (gal)" %>
    <%= f.field :fuel_added_type, label: "Fuel type", placeholder: "100LL" %>
  </fieldset>
  <%= f.field :route, as: :textarea, rows: 2 %>
  <%= f.field :notes, as: :textarea, rows: 2 %>
  <div class="grid gap-4 sm:grid-cols-2">
    <%= f.field :track_log, as: :file, label: "Track log (GPX/KML/CSV)" %>
    <%= f.field :engine_data, as: :file, label: "Engine monitor data", hint: "CGR-30P / CGR-30C flight recording (.csv).", accept: ".csv,text/csv" %>
  </div>
  <p class="hint">Saving adds the tach time to the aircraft and all in-service components, and records any oil/fuel added.</p>
  <div class="flex gap-2"><%= f.submit "Log Flight" %><%= link_to "Cancel", aircraft_flight_logs_path(@aircraft), class: "btn-secondary" %></div>
<% end %>
