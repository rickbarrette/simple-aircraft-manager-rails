<%= form_with model: record, url: record.new_record? ? aircraft_inspection_records_path(aircraft) : aircraft_inspection_record_path(aircraft, record), class: "card card-body space-y-4 max-w-2xl" do |f| %>
  <%= f.errors_summary %>
  <%= f.field :inspection_type_id, as: :select, label: "Inspection", collection: aircraft.applicable_inspection_types.ordered.map { [_1.name, _1.id] } %>
  <div class="grid gap-4 sm:grid-cols-2">
    <%= f.field :date, as: :date %>
    <%= f.field :aircraft_hours, as: :number, step: 0.1, label: "Aircraft hours (tach)" %>
    <%= f.field :component_id, as: :select, label: "Component (if component-level)", collection: component_options(aircraft) %>
    <%= f.field :logbook_entry_id, as: :select, label: "Logbook entry", collection: logbook_options(aircraft) %>
  </div>
  <%= f.field :notes, as: :textarea, rows: 2 %>
  <div class="flex gap-2"><%= f.submit "Save" %><%= link_to "Cancel", aircraft_inspections_path(aircraft), class: "btn-secondary" %></div>
<% end %>
<% if record.persisted? %><div class="mt-4"><%= delete_button "Delete record", aircraft_inspection_record_path(aircraft, record) %></div><% end %>
