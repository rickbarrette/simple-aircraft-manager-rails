<% content_for :title, t(".sign_a_logbook_entry") %>
<div class="mx-auto max-w-md card card-body space-y-3">
  <h1 class="card-title"><%= t(".wrong_account") %></h1>
  <p class="text-sm text-slate-600"><%= t(".this_invitation_is_for_but_html", email: @invitation.email, email_address: current_user.email_address) %></p>
  <%= button_to t(".sign_out"), session_path, method: :delete, class: "btn-secondary" %>
</div>
