<!DOCTYPE html>
<html class="h-full bg-slate-100">
  <head>
    <title><%= [content_for(:title), "Simple Aircraft Manager"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full text-slate-800">
    <header class="bg-slate-900 text-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
        <%= link_to root_path, class: "flex items-center gap-2 font-semibold tracking-tight" do %>
          <span class="text-xl">✈</span> Simple Aircraft Manager
        <% end %>
        <% if current_user %>
          <nav class="flex items-center gap-4 text-sm">
            <%= link_to "Fleet", root_path, class: "hover:text-sky-300" %>
            <% if current_user.admin? %>
              <%= link_to "Users", admin_users_path, class: "hover:text-sky-300" %>
              <%= link_to "Component Types", admin_component_types_path, class: "hover:text-sky-300 hidden sm:inline" %>
            <% end %>
            <%= link_to current_user.display_name, edit_profile_path, class: "text-slate-300 hover:text-sky-300 hidden sm:inline" %>
            <%= button_to "Sign out", session_path, method: :delete, class: "rounded bg-slate-700 px-2 py-1 hover:bg-slate-600" %>
          </nav>
        <% end %>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-6">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
