<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full bg-page">
  <head>
    <meta charset="utf-8">
    <%= render "shared/theme_script" %>
    <title><%= [content_for(:title), t(".simple_aircraft_manager")].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="manifest" href="/manifest.json" crossorigin="use-credentials">
    <meta name="theme-color" content="#0f172a">
    <meta name="apple-mobile-web-app-title" content="SAM">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <meta name="rendered-at" content="<%= Time.current.iso8601 %>">
    <% if current_user %><meta name="current-user" content="<%= current_user.id %>"><% end %>
    <script type="application/json" id="i18n" nonce="<%= content_security_policy_nonce %>"><%= json_escape(t("js").to_json).html_safe %></script>
  </head>

  <body class="min-h-full text-slate-800" data-controller="offline-sync page-age app-update<%= " offline-prep" if current_user %>"<% if current_user %> data-offline-prep-aircraft-value="<%= offline_pages.to_json %>"<% end %>>
    <%= t(".skip_to_content_html") %>
    <%# Solid and stuck to the top: iOS 26 home-screen apps then extend its color under the status bar instead of blurring it. %>
    <header class="sticky top-0 z-40 bg-header text-white">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
        <%= link_to root_path, class: "flex items-center gap-2 font-semibold tracking-tight whitespace-nowrap" do %>
          <span class="text-xl">✈</span> <span class="hidden sm:inline"><%= t(".simple_aircraft_manager") %></span><span class="sm:hidden" aria-label="<%= t(".simple_aircraft_manager") %>"><%= t(".sam") %></span>
        <% end %>
        <% if current_user %>
          <%# Phones: Fleet, theme and one menu for the rest. %>
          <nav class="flex items-center gap-1 text-sm sm:hidden" aria-label="<%= t(".main") %>">
            <%= link_to t(".fleet"), root_path, class: "rounded px-3 py-2 hover:bg-white/10" %>
            <%= render "shared/theme_toggle" %>
            <details class="relative" data-controller="dropdown" data-action="click@window->dropdown#closeOutside keydown.esc@window->dropdown#close">
              <summary class="flex cursor-pointer list-none items-center rounded px-3 py-2 text-lg leading-none hover:bg-white/10 [&::-webkit-details-marker]:hidden" aria-label="<%= t(".menu") %>">☰</summary>
              <div class="absolute right-0 z-30 mt-2 w-56 rounded-md bg-surface py-1 text-slate-700 shadow-lg ring-1 ring-slate-200">
                <p class="truncate px-4 pt-2 pb-1 text-xs text-slate-500"><%= current_user.email_address %></p>
                <%= link_to t(".profile"), edit_profile_path, class: "block px-4 py-2.5 hover:bg-slate-100" %>
                <%= link_to t(".search"), search_path, class: "block px-4 py-2.5 hover:bg-slate-100" %>
                <%= link_to t(".help"), help_path, class: "block px-4 py-2.5 hover:bg-slate-100" %>
                <% if current_user.admin? %>
                  <p class="border-t border-slate-100 px-4 pt-2 pb-1 text-xs font-semibold text-slate-500"><%= t(".admin") %></p>
                  <% [ [ t(".users"), admin_users_path ], [ t(".component_types"), admin_component_types_path ], [ t(".airports"), admin_airports_path ], [ t(".logbook_templates"), admin_logbook_templates_path ], [ t(".settings"), edit_admin_settings_path ], [ t(".off_site_backup"), admin_offsite_backup_path ], [ t(".recordkeeping_procedures"), admin_procedures_path ], [ t(".records_audits"), admin_audits_path ], [ t(".about"), admin_about_path ] ].each do |label, path| %>
                    <%= link_to label, path, class: "block px-4 py-2.5 hover:bg-slate-100" %>
                  <% end %>
                <% end %>
                <div class="border-t border-slate-100"><%= button_to t(".sign_out"), session_path, method: :delete, class: "block w-full px-4 py-2.5 text-left hover:bg-slate-100", form: { data: { controller: "sign-out", action: "submit->sign-out#clean" } } %></div>
              </div>
            </details>
          </nav>
          <nav class="hidden items-center gap-4 text-sm sm:flex" aria-label="<%= t(".main") %>">
            <%= form_with url: search_path, method: :get, class: "hidden md:block", html: { role: "search" } do %>
              <%= search_field_tag :q, params[:q], placeholder: t(".search_2"), "aria-label": t(".search_the_records"),
                    class: "w-40 rounded bg-white/10 px-2 py-1 text-sm text-white placeholder:text-white/60 focus:w-56 focus:bg-white/20 focus:outline-none transition-all lg:w-48" %>
            <% end %>
            <%= link_to t(".search"), search_path, class: "hover:text-sky-300 md:hidden" %>
            <%= link_to t(".fleet"), root_path, class: "hover:text-sky-300" %>
            <% if current_user.admin? %>
              <details class="relative" data-controller="dropdown" data-action="click@window->dropdown#closeOutside keydown.esc@window->dropdown#close">
                <summary class="flex cursor-pointer list-none items-center gap-1 hover:text-sky-300 [&::-webkit-details-marker]:hidden">
                  <%= t(".admin") %> <span aria-hidden="true" class="text-xs">▾</span>
                </summary>
                <div class="absolute right-0 z-30 mt-2 w-48 rounded-md bg-surface py-1 text-slate-700 shadow-lg ring-1 ring-slate-200">
                  <% [ [ t(".users"), admin_users_path ], [ t(".component_types"), admin_component_types_path ], [ t(".airports"), admin_airports_path ], [ t(".logbook_templates"), admin_logbook_templates_path ], [ t(".settings"), edit_admin_settings_path ], [ t(".off_site_backup"), admin_offsite_backup_path ], [ t(".recordkeeping_procedures"), admin_procedures_path ], [ t(".records_audits"), admin_audits_path ], [ t(".about"), admin_about_path ] ].each do |label, path| %>
                    <%= link_to label, path, class: [ "block px-4 py-2 text-sm hover:bg-slate-100", ("font-semibold text-sky-700" if current_page?(path)) ] %>
                  <% end %>
                </div>
              </details>
            <% end %>
            <%= link_to t(".help"), help_path, class: "hover:text-sky-300" %>
            <%= link_to current_user.display_name, edit_profile_path, class: "text-white/70 hover:text-sky-300 hidden sm:inline" %>
            <%= render "shared/theme_toggle" %>
            <%= button_to t(".sign_out"), session_path, method: :delete, class: "rounded bg-white/10 px-2 py-1 hover:bg-white/20", form: { data: { controller: "sign-out", action: "submit->sign-out#clean" } } %>
          </nav>
        <% end %>
      </div>
    </header>
    <div class="hidden bg-sky-50 px-4 py-2 text-center text-sm text-sky-900 ring-1 ring-sky-200" data-page-age-target="banner" role="status"></div>
    <div class="hidden bg-sky-50 px-4 py-2 text-center text-sm text-sky-900 ring-1 ring-sky-200" data-app-update-target="banner" role="status">
      <%= t(".updated") %> <button type="button" class="btn-secondary btn-sm ml-1" data-action="app-update#reload"><%= t(".reload") %></button>
    </div>
    <div class="hidden space-y-1 bg-amber-50 px-4 py-2 text-center text-sm text-amber-900 ring-1 ring-amber-200" data-offline-sync-target="banner" role="status"></div>

    <main id="main" tabindex="-1" class="mx-auto max-w-7xl px-4 py-6 focus:outline-none">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
    <%= render "shared/disclaimer_footer" %>
  </body>
</html>
