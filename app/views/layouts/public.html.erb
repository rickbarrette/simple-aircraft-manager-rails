<!DOCTYPE html>
<html class="h-full bg-slate-100">
  <head>
    <title><%= [content_for(:title), "Simple Aircraft Manager"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/icon.png" type="image/png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-full text-slate-800">
    <header class="bg-slate-900 text-white">
      <div class="mx-auto max-w-7xl px-4 py-3 font-semibold"><span class="text-xl">✈</span> Simple Aircraft Manager</div>
    </header>
    <main class="mx-auto max-w-7xl px-4 py-6">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
