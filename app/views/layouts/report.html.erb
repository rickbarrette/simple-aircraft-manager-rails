<!DOCTYPE html>
<html class="bg-white" data-theme="light">
  <head>
    <title><%= [content_for(:title), "Simple Aircraft Manager"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <style>
      html, body { background: #fff; }
      @page { margin: 0.5in; }
    </style>
  </head>
  <body class="bg-white text-slate-900 report">
    <main class="mx-auto max-w-5xl px-4 py-6 print:max-w-none print:p-0"><%= yield %></main>
  </body>
</html>
