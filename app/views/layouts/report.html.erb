<!DOCTYPE html>
<html lang="en" class="bg-white" data-theme="light">
  <head>
    <meta charset="utf-8">
    <title><%= [content_for(:title), "Simple Aircraft Manager"].compact.join(" · ") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Always a full page load: a Turbo visit would keep the app's dark theme
        on this white page, and leave this page's styles behind on Back. %>
    <meta name="turbo-visit-control" content="reload">
    <% unless @standalone %><link rel="icon" href="/favicon.svg" type="image/svg+xml"><% end %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%# No Turbo here (Back is then an ordinary page load); just the Print button. %>
    <script nonce="<%= content_security_policy_nonce %>">
      document.addEventListener("click", (e) => { if (e.target.closest?.("[data-print]")) window.print() })
    </script>
    <style>
      html, body { background: #fff; }
      @page { margin: 0.5in; }
    </style>
  </head>
  <body class="bg-white text-slate-900 report">
    <main class="mx-auto max-w-5xl px-4 py-6 print:max-w-none print:p-0"><%= yield %></main>
  </body>
</html>
