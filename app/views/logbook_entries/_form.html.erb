<%= form_with model: [aircraft, entry], class: "card card-body space-y-4 max-w-3xl", data: { controller: "entry-template" } do |f| %>
  <%= f.errors_summary %>
  <% if entry.new_record? %>
    <div>
      <%= label_tag :template, "Preventive maintenance template", class: "label" %>
      <select id="template" class="input" data-entry-template-target="template" data-action="entry-template#apply">
        <option value="">— Write it yourself —</option>
        <% PreventiveMaintenance::ITEMS.each do |item| %>
          <option value="<%= item.key %>" data-text="<%= PreventiveMaintenance.text_for(item) %>"><%= item.label %> (<%= item.paragraphs.join(", ") %>)</option>
        <% end %>
      </select>
      <p class="hint">For a pilot doing preventive maintenance on an aircraft they own or operate (14 CFR 43.3(g)). Fill in the blanks (__) and add your name and pilot certificate number. The item list is paraphrased from Part 43 Appendix A(c); the rule sets each item's limits.</p>
    </div>
  <% end %>
  <div class="grid gap-4 sm:grid-cols-4">
    <%= f.field :date, as: :date %>
    <%= f.field :log_type, as: :select, label: "Logbook", collection: LogbookEntry::LOG_TYPES.invert %>
    <%= f.field :entry_type, as: :select, label: "Entry type", collection: LogbookEntry::ENTRY_TYPES.invert, data: { entry_template_target: "entryType" } %>
    <%= f.field :aircraft_hours_at_entry, as: :number, step: 0.1, label: "Aircraft hours" %>
  </div>
  <%= f.field :text, as: :textarea, label: "Entry text", rows: 8, data: { entry_template_target: "text" } %>
  <p class="hint !mt-1">A maintenance entry needs a description of the work, the date, and the name, signature, certificate number and kind of certificate of whoever approved the return to service (14 CFR 43.9). An inspection entry also needs the type and extent of the inspection, the aircraft's time in service, and the result (43.11).</p>
  <div class="grid gap-4 sm:grid-cols-3">
    <%= f.field :signoff_person, label: "Signed off by", placeholder: "Name" %>
    <%= f.field :signoff_certificate_type, as: :select, label: "Kind of certificate", include_blank: "—",
          collection: LogbookEntry::CERTIFICATE_TYPES.invert, data: { entry_template_target: "certificate" } %>
    <%= f.field :signoff_certificate_number, label: "Certificate number", placeholder: "e.g. 1234567" %>
  </div>
  <div class="grid gap-4 sm:grid-cols-2">
    <%= f.field :inspection_result, as: :select, label: "Inspection result", include_blank: "— Not an inspection —",
          collection: LogbookEntry::INSPECTION_RESULTS.invert, hint: "For inspection entries (43.11)." %>
    <%= f.field :signoff_location, label: "Location / shop" %>
    <%= f.field :document_id, as: :select, label: "Scanned page document", collection: document_options(aircraft) %>
    <%= f.field :page_number, as: :number, label: "Page # in document" %>
  </div>
  <% if entry.persisted? && !entry.verified_was %>
    <%= f.field :verified, as: :checkbox, label: "I've checked this against the scan", hint: "Transcribed by Claude; it stays marked unverified until someone checks it." %>
  <% end %>
  <div class="flex gap-2"><%= f.submit "Save Entry" %><%= link_to "Cancel", aircraft_logbook_entries_path(aircraft), class: "btn-secondary" %></div>
<% end %>
<% if entry.persisted? %><div class="mt-4"><%= delete_button "Delete entry", aircraft_logbook_entry_path(aircraft, entry) %></div><% end %>
