<%= render "shared/aircraft_header", aircraft: @aircraft %>
<section class="card max-w-4xl">
  <div class="card-header">
    <h2 class="card-title"><%= LogbookEntry::LOG_TYPES[@entry.log_type] %> log — <%= fmt_date(@entry.date) %></h2>
    <div class="flex gap-2">
      <%= link_to "Print for logbook", new_aircraft_logbook_print_path(@aircraft, ids: [ @entry.id ]), class: "btn-secondary btn-sm" %>
      <% if owner? %><%= link_to "Edit", edit_aircraft_logbook_entry_path(@aircraft, @entry), class: "btn-secondary btn-sm" %><% end %>
    </div>
  </div>
  <div class="card-body space-y-3">
    <% unless @entry.verified? %>
      <div class="flex flex-wrap items-center justify-between gap-2 rounded-md bg-amber-50 px-3 py-2 text-sm text-amber-900 ring-1 ring-amber-200">
        <span>Transcribed by Claude<%= " (#{@entry.transcription_confidence} confidence)" if @entry.transcription_confidence %> and not yet checked. Compare it with the scan<%= @entry.document ? "" : " or the paper logbook" %> before relying on it.</span>
        <% if owner? %><%= button_to "Matches the scan: mark verified", verify_aircraft_logbook_entry_path(@aircraft, @entry), method: :patch, class: "btn-secondary btn-sm" %><% end %>
      </div>
    <% end %>
    <div class="flex flex-wrap gap-4 text-sm text-slate-600">
      <span>Type: <%= LogbookEntry::ENTRY_TYPES[@entry.entry_type] %></span>
      <span>Airframe total time: <%= hours(@entry.aircraft_hours_at_entry) %></span>
      <% if (c = @entry.component) %>
        <span><%= c %> <%= c.model %><%= " S/N #{c.serial_number}" if c.serial_number.present? %>:
          <%= hours(@entry.component_hours_at_entry) %> total, <%= hours(@entry.component_since_overhaul_at_entry) %> <%= c.since_overhaul_abbreviation %></span>
      <% end %>
      <% @entry.parts.each do |part| %>
        <% pc = part.component %>
        <span><%= pc %> <%= pc.model %><%= " S/N #{pc.serial_number}" if pc.serial_number.present? %>:
          <%= hours(part.hours_at_entry) %> total, <%= hours(part.since_overhaul_at_entry) %> <%= pc.since_overhaul_abbreviation.downcase %></span>
      <% end %>
    </div>
    <div class="whitespace-pre-wrap rounded bg-slate-50 p-3 font-mono text-sm"><%= @entry.text %></div>
    <div class="text-sm text-slate-600">
      Signed off: <%= @entry.signoff_person.presence || "—" %>
      <%= ", #{@entry.certificate_label}" if @entry.certificate_label %><%= " ##{@entry.signoff_certificate_number}" if @entry.signoff_certificate_number %>
      <%= "(#{@entry.signoff_location})" if @entry.signoff_location.present? %>
    </div>
    <% if @entry.inspection_result %><div class="text-sm text-slate-600">Result: <%= @entry.inspection_result_label %></div><% end %>
    <% if (missing = @entry.missing_record_items).any? %>
      <p class="rounded-md bg-amber-50 px-3 py-2 text-sm text-amber-900 ring-1 ring-amber-200">
        Missing for <%= @entry.entry_type == "INSPECTION" ? "43.11" : "43.9" %>: <%= missing.to_sentence %>.
        <%= link_to("Fill in", edit_aircraft_logbook_entry_path(@aircraft, @entry), class: "link") if owner? %>
        (Check against the signed logbook.)
      </p>
    <% end %>
    <% if @entry.document %>
      <p class="text-sm">Scan: <%= link_to @entry.document.name, aircraft_document_path(@aircraft, @entry.document, page: @entry.page_number), class: "link" %><%= " (page #{@entry.page_number})" if @entry.page_number %></p>
    <% end %>
  </div>
</section>
