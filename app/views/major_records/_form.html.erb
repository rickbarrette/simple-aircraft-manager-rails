<%= form_with model: [aircraft, record], class: "card card-body space-y-4 max-w-3xl" do |f| %>
  <%= f.errors_summary %>
  <div class="grid gap-4 sm:grid-cols-3">
    <%= f.field :record_type, as: :select, label: t(".type"), collection: MajorRecord::RECORD_TYPES.invert %>
    <%= f.field :date_performed, as: :date %>
    <%= f.field :aircraft_hours, as: :number, step: 0.1 %>
  </div>
  <%= f.field :title, required: true %>
  <%= f.field :description, as: :textarea, rows: 4 %>
  <div class="grid gap-4 sm:grid-cols-2">
    <%= f.field :performed_by %>
    <%= f.field :component_id, as: :select, label: t(".component"), collection: component_options(aircraft) %>
    <%= f.field :form_337_document_id, as: :select, label: t(".form_337_document"), collection: document_options(aircraft) %>
    <%= f.field :logbook_entry_id, as: :select, label: t(".logbook_entry"), collection: logbook_options(aircraft) %>
    <%= f.field :stc_number, label: t(".stc_number") %>
    <%= f.field :stc_holder, label: t(".stc_holder") %>
    <%= f.field :stc_document_id, as: :select, label: t(".stc_document"), collection: document_options(aircraft) %>
  </div>
  <%= f.field :has_ica, as: :checkbox, label: t(".includes_instructions_for_continued_airworthines") %>
  <%= f.field :ica_notes, as: :textarea, rows: 2, label: t(".ica_notes") %>
  <%= f.field :notes, as: :textarea, rows: 2 %>
  <div class="flex gap-2"><%= f.submit t(".save") %><%= link_to t(".cancel"), aircraft_major_records_path(aircraft), class: "btn-secondary" %></div>
<% end %>
<% if record.persisted? %><div class="mt-4"><%= delete_button t(".delete_record"), aircraft_major_record_path(aircraft, record) %></div><% end %>
