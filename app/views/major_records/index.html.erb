<% content_for :title, "#{@aircraft.tail_number} Major Records" %>
<%= render "shared/aircraft_header", aircraft: @aircraft %>
<section class="card">
  <div class="card-header"><h2 class="card-title">Major Repairs & Alterations</h2>
    <% if owner? %><div class="flex gap-2">
      <%= link_to "+ Repair", new_aircraft_major_record_path(@aircraft, type: "repair"), class: "btn-secondary" %>
      <%= link_to "+ Alteration", new_aircraft_major_record_path(@aircraft, type: "alteration"), class: "btn-primary" %></div><% end %></div>
  <% if @records.any? %>
    <table class="table">
      <thead><tr><th>Date</th><th>Type</th><th>Title</th><th>Performed by</th><th>STC</th><th>ICA</th></tr></thead>
      <tbody>
        <% @records.each do |r| %>
          <tr>
            <td class="whitespace-nowrap"><%= r.date_performed %></td>
            <td><%= tag.span r.type_label, class: r.record_type == "repair" ? "badge-orange" : "badge-blue" %></td>
            <td><%= link_to r.title, aircraft_major_record_path(@aircraft, r), class: "link" %><%= tag.div(r.component, class: "text-xs text-slate-500") if r.component %></td>
            <td class="text-xs"><%= r.performed_by %></td>
            <td class="text-xs"><%= r.stc_number %></td>
            <td><%= "✓" if r.has_ica? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= empty_state "No major repairs or alterations recorded." %>
  <% end %>
</section>
