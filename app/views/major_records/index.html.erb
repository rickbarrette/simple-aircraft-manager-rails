<% content_for :title, t(".major_records", tail_number: @aircraft.tail_number) %>
<%= render "shared/aircraft_header", aircraft: @aircraft %>
<section class="card">
  <div class="card-header"><h2 class="card-title"><%= t(".major_repairs_alterations") %></h2>
    <% if owner? %><div class="flex gap-2">
      <%= link_to t(".repair"), new_aircraft_major_record_path(@aircraft, type: "repair"), class: "btn-secondary" %>
      <%= link_to t(".alteration"), new_aircraft_major_record_path(@aircraft, type: "alteration"), class: "btn-primary" %></div><% end %></div>
  <% if @records.any? %>
    <table class="table">
      <thead><tr><th><%= t(".date") %></th><th><%= t(".type") %></th><th><%= t(".title") %></th><th><%= t(".performed_by") %></th><th><%= t(".stc") %></th><th><%= t(".ica") %></th></tr></thead>
      <tbody>
        <% @records.each do |r| %>
          <tr>
            <td class="whitespace-nowrap"><%= fmt_date(r.date_performed) %></td>
            <td><%= tag.span r.type_label, class: r.record_type == "repair" ? "badge-orange" : "badge-blue" %></td>
            <td><%= link_to r.title, aircraft_major_record_path(@aircraft, r), class: "link" %><%= tag.div(r.component, class: "text-xs text-slate-500") if r.component %></td>
            <td class="text-xs"><%= r.performed_by %></td>
            <td class="text-xs"><%= r.stc_number %></td>
            <td><%= "✓" if r.has_ica? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <%= empty_state t(".no_major_repairs_or_alterations") %>
  <% end %>
</section>
