<% content_for :title, "#{@aircraft.tail_number} Oil Analysis" %>
<%= render "shared/aircraft_header", aircraft: @aircraft %>
<% recent = @analyses.first(OilAnalysesController::COMPARE_SAMPLES) %>
<div class="space-y-5">
  <section class="card">
    <div class="card-header">
      <div>
        <h2 class="card-title">Import a lab report</h2>
        <p class="hint">AvLab PDF reports: each sample on the report (including previous ones) is added unless it's already here.</p>
      </div>
      <%= render "import", aircraft: @aircraft %>
    </div>
  </section>

  <section class="card">
    <div class="card-header">
      <h2 class="card-title">Wear metal trends</h2>
      <%= link_to "+ Add Oil Analysis", new_aircraft_oil_analysis_path(@aircraft), class: "btn-secondary btn-sm" %>
    </div>
    <div class="card-body">
      <% series = oil_trend_series(@analyses) %>
      <% if series.any? %>
        <%= line_chart series, ytitle: "ppm", height: "260px", curve: false, colors: OilAnalysesHelper::TREND_COLORS, legend: "bottom" %>
        <p class="hint">Lead is left out of the chart: it comes from 100LL fuel and reads in the thousands. Look for a steady trend rather than a single reading.</p>
      <% else %>
        <%= empty_state @analyses.any? ? "Add another sample to see trends." : "No oil analyses yet. Add one from your lab report." %>
      <% end %>
    </div>
  </section>

  <% if recent.any?(&:any_results?) %>
    <section class="card">
      <div class="card-header"><h2 class="card-title">Results (ppm)</h2>
        <span class="text-xs text-slate-500">Lab average for similar engines in (parentheses); <span class="font-semibold text-red-700">red</span> is <%= OilAnalysis::FLAG_RATIO %>× or more above it.</span></div>
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr><th>Element</th>
              <% recent.each do |a| %><th class="text-right whitespace-nowrap"><%= link_to fmt_date(a.sample_date), aircraft_oil_analysis_path(@aircraft, a), class: "link" %></th><% end %></tr>
          </thead>
          <tbody>
            <tr class="text-xs text-slate-500"><td>Engine / oil hrs</td>
              <% recent.each do |a| %><td class="text-right tabular-nums"><%= a.engine_hours ? hours(a.engine_hours) : "—" %> / <%= a.oil_hours ? hours(a.oil_hours) : "—" %></td><% end %></tr>
            <% OilAnalysis::ELEMENTS.each do |el, (label, source)| %>
              <% next if recent.none? { _1.value(el) } %>
              <tr><td><span title="<%= source %>"><%= label %></span></td>
                <% recent.each do |a| %><td class="text-right align-top"><%= ppm_cell(a, el) %></td><% end %></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <section class="card">
    <div class="card-header"><h2 class="card-title">Samples</h2></div>
    <% if @analyses.any? %>
      <div class="overflow-x-auto">
        <table class="table">
          <thead><tr><th>Sampled</th><th>Result</th><th>Engine</th><th class="text-right">Engine hrs</th><th class="text-right">Oil hrs</th><th>Lab</th><th>Report</th></tr></thead>
          <tbody>
            <% @analyses.each do |a| %>
              <tr>
                <td class="whitespace-nowrap"><%= link_to fmt_date(a.sample_date), aircraft_oil_analysis_path(@aircraft, a), class: "link" %></td>
                <td class="whitespace-nowrap"><%= oil_status_badge(a) %>
                  <% if (flags = a.flagged_elements).any? %><span class="ml-1 text-xs text-red-700"><%= flags.map { OilAnalysis.element_label(_1) }.to_sentence %> above average</span><% end %></td>
                <td><%= a.component&.to_s || "—" %></td>
                <td class="text-right tabular-nums"><%= a.engine_hours ? hours(a.engine_hours) : "—" %></td>
                <td class="text-right tabular-nums"><%= a.oil_hours ? hours(a.oil_hours) : "—" %></td>
                <td><%= [ a.lab, a.sample_number ].compact.join(" · ").presence || "—" %></td>
                <td><%= a.report.attached? ? link_to("PDF", rails_blob_path(a.report, disposition: :inline), class: "link", target: "_blank", rel: "noopener") : "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <%= empty_state "No samples recorded." %>
    <% end %>
  </section>
</div>
