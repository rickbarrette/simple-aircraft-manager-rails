<p>Here's what needs attention<%= " on your aircraft" if @items.any? %>.</p>
<% @items.each do |aircraft, issues, alerts| %>
  <h3 style="margin: 16px 0 4px;"><%= link_to aircraft.tail_number, aircraft_url(aircraft) %> <span style="font-weight: normal; color: #64748b;"><%= aircraft.airworthiness.label %></span></h3>
  <ul style="margin: 0; padding-left: 20px;">
    <% issues.each do |issue| %>
      <li><strong><%= { "RED" => "Overdue", "LIMITED" => "Overdue", "ORANGE" => "Due soon", "INFO" => "Deferred" }[issue.severity] %>:</strong>
        <%= issue.title %> <span style="color: #64748b;"><%= issue.description %></span></li>
    <% end %>
  </ul>
  <% if alerts.any? %>
    <p style="margin: 8px 0 0;"><strong><%= alerts.size %> newly published <%= "AD".pluralize(alerts.size) %> may apply:</strong>
      <%= alerts.map { _1.ad_number || _1.fr_document_number }.to_sentence %>. <%= link_to "Review them", aircraft_airworthiness_directives_url(aircraft, anchor: "new-ads") %>.</p>
  <% end %>
<% end %>
<% if @certificates.any? %>
  <h3 style="margin: 16px 0 4px;">Your certificates</h3>
  <ul style="margin: 0; padding-left: 20px;">
    <% @certificates.each do |c| %><li><strong><%= c.expired? ? "Expired" : "Expires" %> <%= c.expires_on %>:</strong> <%= c.kind_label %> <%= c.number %></li><% end %>
  </ul>
<% end %>
<p style="color: #64748b; font-size: 12px; margin-top: 20px;">
  Based on the records in Simple Aircraft Manager. Turn these emails off on your <%= link_to "profile", edit_profile_url %>.
</p>
