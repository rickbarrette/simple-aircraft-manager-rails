<% if notice.present? %>
  <div class="mb-4 rounded-md bg-emerald-50 px-4 py-2 text-sm text-emerald-800 ring-1 ring-emerald-200"><%= notice %></div>
<% end %>
<% if alert.present? %>
  <div class="mb-4 rounded-md bg-red-50 px-4 py-2 text-sm text-red-800 ring-1 ring-red-200"><%= alert %></div>
<% end %>
