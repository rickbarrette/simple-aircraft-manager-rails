<% content_for :title, "Email me a sign-in link" %>
<div class="mx-auto max-w-sm">
  <h1 class="mb-4 text-2xl font-bold">Sign in by email</h1>
  <%= form_with url: sign_in_links_path, class: "card card-body space-y-4" do |form| %>
    <p class="text-sm text-slate-600">We'll email you a link that signs you in. It works once, for 15 minutes.</p>
    <div><%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %></div>
    <%= form.submit "Email me a link", class: "btn-primary w-full justify-center" %>
    <p class="text-center text-sm"><%= link_to "Back to sign in", new_session_path, class: "link" %></p>
  <% end %>
</div>
