<% content_for :title, t(".email_me_a_sign_in") %>
<div class="mx-auto max-w-sm">
  <h1 class="mb-4 text-2xl font-bold"><%= t(".sign_in_by_email") %></h1>
  <%= form_with url: sign_in_links_path, class: "card card-body space-y-4" do |form| %>
    <p class="text-sm text-slate-600"><%= t(".we_ll_email_you_a") %></p>
    <div><%= form.label :email_address, t(".email"), class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "input" %></div>
    <%= form.submit t(".email_me_a_link"), class: "btn-primary w-full justify-center" %>
    <p class="text-center text-sm"><%= link_to t(".back_to_sign_in"), new_session_path, class: "link" %></p>
  <% end %>
</div>
