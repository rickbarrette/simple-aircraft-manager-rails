<%= raw t(".you_electronically_signed_a_logbook_2_text", tail_number: @entry.aircraft.tail_number) %>
<%= raw t(".entry_log_2_text", date: (fmt_date(@entry.date)), log_type: (LogbookEntry::LOG_TYPES[@entry.log_type])) %>
<%= raw t(".certified_by_2_text", signer_name: @signature.signer_name, certificate_label: @signature.certificate_label, certificate_number: @signature.certificate_number) %>
<%= raw t(".signed_text", d: (@signature.signed_at.utc.strftime("%Y-%m-%d %H:%M:%S UTC"))) %>
<%= raw t(".statement_2_text", statement: @signature.statement) %>
<%= raw t(".fingerprint_text", content_digest: @signature.content_digest) %>

<%= raw t(".if_you_didn_t_sign") %>
