<% content_for :title, t(".ask_someone_to_sign") %>
<%= render "shared/aircraft_header", aircraft: @aircraft %>
<%= form_with model: @invitation, url: aircraft_logbook_entry_signing_invitations_path(@aircraft, @entry), class: "card card-body max-w-2xl space-y-4" do |f| %>
  <h2 class="card-title"><%= t(".ask_someone_to_sign") %></h2>
  <p class="text-sm text-slate-600"><%= t(".for_a_mechanic_who_did") %></p>
  <%= f.errors_summary %>
  <div class="rounded-md bg-slate-50 p-3 text-sm"><%= t(".log_html", date: (fmt_date(@entry.date)), log_type: (LogbookEntry::LOG_TYPES[@entry.log_type]), truncate: (@entry.text.truncate(160))) %></div>
  <%= f.field :email, as: :email, label: t(".their_email"), required: true %>
  <%= f.field :message, as: :textarea, rows: 2, label: t(".message_optional") %>
  <div class="flex gap-2"><%= f.submit t(".send_invitation") %><%= link_to t(".cancel"), aircraft_logbook_entry_path(@aircraft, @entry), class: "btn-secondary" %></div>
<% end %>
