<%= form_with model: [aircraft, squawk], multipart: true, class: "card card-body space-y-4 max-w-2xl",
      data: (squawk.new_record? ? { controller: "offline-form", offline_form_kind_value: "squawk", offline_form_tail_value: aircraft.tail_number,
                                    action: "submit->offline-form#submit turbo:submit-start->offline-form#remember turbo:fetch-request-error->offline-form#networkFailed turbo:before-fetch-response->offline-form#gatewayFailed" } : {}) do |f| %>
  <% if squawk.new_record? %>
    <%= f.hidden_field :client_key, data: { offline_form_target: "key" } %>
    <div class="hidden rounded-md bg-sky-50 px-3 py-2 text-sm text-sky-900 ring-1 ring-sky-200" data-offline-form-target="notice" role="status"></div>
  <% end %>
  <%= f.errors_summary %>
  <%= f.field :priority, as: :select, collection: Squawk::PRIORITIES.invert, hint: t(".ground_aircraft_makes_the_aircraft") %>
  <%= f.field :issue_reported, as: :textarea, label: t(".issue"), required: true, autofocus: true %>
  <%= f.field :component_id, as: :select, label: t(".component_optional"), collection: component_options(aircraft) %>
  <%= f.field :attachments, as: :file, multiple: true, label: squawk.attachments.attached? ? t(".add_photos_files") : t(".photos_files"),
        hint: t(".select_several_at_once_images", max_upload_mb: Setting.max_upload_mb) %>
  <% if squawk.persisted? && squawk.attachments.attached? %>
    <div>
      <p class="label"><%= t(".remove_attached_files") %></p>
      <% squawk.attachments.each do |file| %>
        <label class="flex items-center gap-2 text-sm"><%= check_box_tag "remove_attachment_ids[]", file.id, false, id: "remove_attachment_#{file.id}" %> <%= file.filename %></label>
      <% end %>
    </div>
  <% end %>
  <% if squawk.persisted? %><%= f.field :notes, as: :textarea, rows: 3 %><% end %>
  <div class="flex gap-2">
    <%= f.submit squawk.new_record? ? t(".report_squawk") : t(".save") %>
    <%= link_to t(".cancel"), aircraft_squawks_path(aircraft), class: "btn-secondary" %>
  </div>
<% end %>
<% if squawk.persisted? && owner? %>
  <div class="mt-4"><%= delete_button t(".delete_squawk"), aircraft_squawk_path(aircraft, squawk) %></div>
<% end %>
