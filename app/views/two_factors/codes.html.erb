<% content_for :title, t(".recovery_codes") %>
<section class="card card-body mx-auto max-w-md space-y-4">
  <h1 class="text-2xl font-bold"><%= t(".save_your_recovery_codes") %></h1>
  <p class="text-sm text-slate-600"><%= t(".two_factor_is_on_if") %></p>
  <ul class="grid grid-cols-2 gap-2 rounded-md bg-slate-50 p-4 font-mono text-sm ring-1 ring-slate-200">
    <% @codes.each do |c| %><li><%= c %></li><% end %>
  </ul>
  <%= link_to t(".done"), back_path, class: "btn-primary self-start" %>
</section>
