<%# The loading calculator (W&B tab). %>
<div class="card-body space-y-3" data-controller="wb-calculator"
     data-wb-calculator-empty-weight-value="<%= record.empty_weight.to_f %>" data-wb-calculator-empty-moment-value="<%= record.empty_moment.to_f %>"
     data-wb-calculator-max-gross-value="<%= record.max_gross_weight.to_f %>" data-wb-calculator-fuel-density-value="<%= setup.fuel_lb_per_gal.to_f %>"
     data-wb-calculator-envelope-value="<%= setup.envelope.map { |w, c| [ w.to_f, c.to_f ] }.to_json %>">
  <div class="grid gap-2 sm:grid-cols-2">
    <% setup.stations.each do |st| %>
      <label class="text-sm">
        <span class="label"><%= st.name %> <span class="font-normal text-slate-500"><%= t(".arm_in_html", arm: st.arm, max: (t(".max", max: (st.max.to_s.sub(/\.0\z/, '')), unit: (st.fuel ? t('.gal') : t('.lb'))) if st.max)) %></span></span>
        <span class="flex items-center gap-2">
          <input type="number" min="0" step="0.1" class="input" inputmode="decimal" data-wb-calculator-target="station"
                 data-arm="<%= st.arm.to_f %>" data-fuel="<%= st.fuel %>" data-max="<%= st.max.to_f %>" data-action="input->wb-calculator#update">
          <span class="w-6 text-xs text-slate-500"><%= st.fuel ? "gal" : "lb" %></span>
        </span>
      </label>
    <% end %>
    <% if setup.stations.any?(&:fuel) %>
      <label class="text-sm"><span class="label"><%= t(".fuel_burned_in_flight") %></span>
        <span class="flex items-center gap-2"><input type="number" min="0" step="0.1" class="input" inputmode="decimal" data-wb-calculator-target="burn" data-action="input->wb-calculator#update"><span class="w-6 text-xs text-slate-500"><%= t(".gal") %></span></span></label>
    <% end %>
  </div>
  <div class="grid items-start gap-3 sm:grid-cols-[1fr_auto]">
    <table class="w-full text-sm table-keep">
      <thead><tr class="text-left text-xs uppercase text-slate-500"><th></th><th class="text-right"><%= t(".weight") %></th><th class="text-right"><%= t(".cg") %></th><th class="text-right"><%= t(".moment") %></th></tr></thead>
      <tbody>
        <tr><td><%= t(".takeoff") %></td><td class="text-right tabular-nums" data-wb-calculator-target="takeoffWeight">—</td><td class="text-right tabular-nums" data-wb-calculator-target="takeoffCg">—</td><td class="text-right tabular-nums" data-wb-calculator-target="takeoffMoment">—</td></tr>
        <tr><td><%= t(".landing") %></td><td class="text-right tabular-nums" data-wb-calculator-target="landingWeight">—</td><td class="text-right tabular-nums" data-wb-calculator-target="landingCg">—</td><td class="text-right tabular-nums" data-wb-calculator-target="landingMoment">—</td></tr>
      </tbody>
    </table>
    <svg viewBox="0 0 220 160" class="h-40 w-56 rounded bg-slate-50" data-wb-calculator-target="chart" aria-label="<%= t(".cg_envelope") %>"></svg>
  </div>
  <ul class="space-y-1 text-sm" data-wb-calculator-target="messages" role="status"></ul>
  <p class="hint"><%= t(".a_planning_aid_from_the") %></p>
</div>
