<%= form_with model: [aircraft, record], url: record.new_record? ? aircraft_weight_balance_records_path(aircraft) : aircraft_weight_balance_record_path(aircraft, record),
              class: "card card-body space-y-4 max-w-2xl" do |f| %>
  <%= f.errors_summary %>
  <p class="text-sm text-slate-600"><%= t(".the_figures_from_the_weight") %></p>
  <div class="grid gap-4 sm:grid-cols-2">
    <%= f.field :date, as: :date %>
    <%= f.field :reason, placeholder: t(".e_g_weighed_at_annual") %>
    <%= f.field :empty_weight, as: :number, step: 0.1, label: t(".empty_weight_lb"), required: true %>
    <%= f.field :empty_arm, as: :number, step: 0.01, label: t(".empty_cg_arm_in_aft"), required: true %>
    <%= f.field :max_gross_weight, as: :number, step: 0.1, label: t(".max_gross_weight_lb") %>
    <%= f.field :major_record_id, as: :select, label: t(".alteration_337"),
          collection: [ [ t(".none"), nil ] ] + aircraft.major_records.recent_first.map { [ "#{_1.date_performed} – #{_1.title.truncate(50)}", _1.id ] } %>
    <%= f.field :document_id, as: :select, label: t(".w_b_report_document"), collection: document_options(aircraft) %>
  </div>
  <%= f.field :notes, as: :textarea, rows: 2 %>
  <div class="flex gap-2"><%= f.submit t(".save") %><%= link_to t(".cancel"), aircraft_weight_balance_records_path(aircraft), class: "btn-secondary" %></div>
<% end %>
<% if record.persisted? %><div class="mt-4"><%= delete_button t(".delete_record"), aircraft_weight_balance_record_path(aircraft, record) %></div><% end %>
